# Environment for the canonical runs. Copy it outside git (for example to .env.canonical),
# fill in the values, then load it before any step:
#
#   set -a; . ./.env.canonical; set +a
#
# Names only: this file never holds values, and none of these variables is a secret.

# Root of the prepared stores (prepare_data.py writes <root>/<dataset>/). Required.
JIGSAW_STORE_ROOT=

# Root for logs, query sets, training runs and experiment outputs.
# Default in prepare_all.sh: $JIGSAW_STORE_ROOT/_logs.
JIGSAW_RUNS_ROOT=

# Offline dataset copies (CoraFull/, ogbn_arxiv/, ogbn_mag/, ...). Default: <repo>/data.
JIGSAW_DATA_ROOT=

# Glasgow Subgraph Solver built by external/build_glasgow.sh
# (normally <repo>/external/bin/glasgow_subgraph_solver).
GLASGOW_SOLVER_BIN=

# SubgraphMatching built by external/build_subgraphmatching.sh
# (normally <repo>/external/bin/subgraphmatching/SubgraphMatching.out).
SUBGRAPHMATCHING_BIN=

# GNN-PE built by external/build_gnnpe.sh (normally <repo>/external/bin/gnnpe/main); E12 only.
GNNPE_BIN=

# KaHIP kaffpa, only for the kahip_fast sensitivity partition (prepare_data.py --alternatives).
# Leave empty to skip that partition; kaffpa on PATH is used when this is empty.
KAHIP_BIN=

# gpmetis (METIS 5.1.0). When set or on PATH, prepare_data.py uses it instead of pymetis
# (--metis-tool auto). Keep one choice for every dataset of a paper run.
GPMETIS_BIN=

# GPUs visible to training and serving, for example 0 or 0,1.
CUDA_VISIBLE_DEVICES=
